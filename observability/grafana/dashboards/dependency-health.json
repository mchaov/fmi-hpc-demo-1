{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 15,
      "options": {
        "content": "**Workload Profile:** ${workload_profile:csv}  \n**Test Run ID:** ${test_run_id:csv}  \n**Operation:** ${operation:csv}  \n**API Route:** ${route:csv}  \n**API Mode:** ${mode:csv}  \nDependency panels are keyed by `operation`. API overlay panels focus on `/api/report` in `dependency` and `degraded` mode so the outbound slice lines up with the user-visible symptom.",
        "mode": "markdown"
      },
      "title": "Selected Filters",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum by (operation) (rate(dependency_requests_total{service=\"demo-api\",operation=~\"$operation\"}[$__rate_interval]))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ],
      "title": "Dependency Calls / sec",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(dependency_requests_total{service=\"demo-api\",operation=~\"$operation\"}[$__rate_interval])) / clamp_min(sum(rate(http_requests_total{service=\"demo-api\",route=~\"$route\",mode=~\"$mode\",route!~\"/(metrics|health)\"}[$__rate_interval])), 0.0001)",
          "legendFormat": "dependency share",
          "refId": "A"
        }
      ],
      "title": "Dependency Calls as Share of API Traffic",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.95, sum by (operation, le) (rate(dependency_request_duration_seconds_bucket{service=\"demo-api\",operation=~\"$operation\"}[$__rate_interval])))",
          "legendFormat": "dependency {{operation}}",
          "refId": "A"
        },
        {
          "expr": "1000 * histogram_quantile(0.95, sum by (mode, le) (rate(http_request_duration_seconds_bucket{service=\"demo-api\",route=\"/api/report\",mode=~\"$mode\",mode=~\"dependency|degraded\"}[$__rate_interval])))",
          "legendFormat": "api {{mode}}",
          "refId": "B"
        }
      ],
      "title": "Dependency vs API p95 Latency",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum by (operation) (rate(dependency_errors_total{service=\"demo-api\",operation=~\"$operation\"}[$__rate_interval])) / clamp_min(sum by (operation) (rate(dependency_requests_total{service=\"demo-api\",operation=~\"$operation\"}[$__rate_interval])), 0.0001)",
          "legendFormat": "dependency {{operation}}",
          "refId": "A"
        },
        {
          "expr": "sum by (mode) (rate(http_requests_total{service=\"demo-api\",route=\"/api/report\",mode=~\"$mode\",mode=~\"dependency|degraded\",status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum by (mode) (rate(http_requests_total{service=\"demo-api\",route=\"/api/report\",mode=~\"$mode\",mode=~\"dependency|degraded\"}[$__rate_interval])), 0.0001)",
          "legendFormat": "api {{mode}}",
          "refId": "B"
        }
      ],
      "title": "Dependency vs API Error Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 70,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "group": "outcome",
              "mode": "normal"
            }
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum by (operation, outcome) (rate(dependency_requests_total{service=\"demo-api\",operation=~\"$operation\"}[$__rate_interval]))",
          "legendFormat": "{{operation}} {{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Dependency Outcome Split",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"demo-dependency\",route=\"/work\"}[$__rate_interval])))",
          "legendFormat": "dependency service p95",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_requests_total{service=\"demo-dependency\",route=\"/work\",status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_requests_total{service=\"demo-dependency\",route=\"/work\"}[$__rate_interval])), 0.0001)",
          "legendFormat": "dependency 5xx rate",
          "refId": "B"
        }
      ],
      "title": "Dependency Service Health",
      "type": "timeseries"
    }
  ],
