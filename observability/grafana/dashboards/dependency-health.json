  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 15,
      "options": {
        "content": "Operation filters outbound calls. Mode filters the API overlay for dependency-backed reports. The whole-API share and downstream service health cover the full interval.",
        "mode": "markdown"
      },
      "title": "All API traffic in this interval",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum by (operation) (rate(dependency_requests_total{service=\"demo-api\",operation=~\"$operation\"}[$__rate_interval]))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ],
      "title": "Dependency Calls / sec",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "(sum(rate(http_requests_total{service=\"demo-api\",route=\"/api/report\",mode=~\"dependency|degraded\"}[$__rate_interval])) or 0 * sum(rate(http_requests_total{service=\"demo-api\",route!~\"/(metrics|health)\"}[$__rate_interval])))\n/ (sum(rate(http_requests_total{service=\"demo-api\",route!~\"/(metrics|health)\"}[$__rate_interval])) > 0)",
          "legendFormat": "dependency share",
          "refId": "A"
        }
      ],
      "title": "Dependency-backed share of all API requests",
      "type": "timeseries",
      "description": "Completed dependency and degraded report requests divided by all completed API requests, excluding health checks and metrics scrapes. This panel covers all routes and modes."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.95, sum by (operation, le) (rate(dependency_request_duration_seconds_bucket{service=\"demo-api\",operation=~\"$operation\"}[$__rate_interval])))",
          "legendFormat": "dependency {{operation}}",
          "refId": "A"
        },
        {
          "expr": "1000 * histogram_quantile(0.95, sum by (mode, le) (rate(http_request_duration_seconds_bucket{service=\"demo-api\",route=\"/api/report\",mode=~\"$mode\",mode=~\"dependency|degraded\"}[$__rate_interval])))",
          "legendFormat": "api {{mode}}",
          "refId": "B"
        }
      ],
      "title": "Dependency vs API p95 Latency",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "(sum by (operation) (rate(dependency_errors_total{service=\"demo-api\",operation=~\"$operation\"}[$__rate_interval]))\n or 0 * sum by (operation) (rate(dependency_requests_total{service=\"demo-api\",operation=~\"$operation\"}[$__rate_interval])))\n/ (sum by (operation) (rate(dependency_requests_total{service=\"demo-api\",operation=~\"$operation\"}[$__rate_interval])) > 0)",
          "legendFormat": "dependency {{operation}}",
          "refId": "A"
        },
        {
          "expr": "(sum by (mode) (rate(http_requests_total{service=\"demo-api\",route=\"/api/report\",mode=~\"$mode\",mode=~\"dependency|degraded\",status_code=~\"5..\"}[$__rate_interval]))\n or 0 * sum by (mode) (rate(http_requests_total{service=\"demo-api\",route=\"/api/report\",mode=~\"$mode\",mode=~\"dependency|degraded\"}[$__rate_interval])))\n/ (sum by (mode) (rate(http_requests_total{service=\"demo-api\",route=\"/api/report\",mode=~\"$mode\",mode=~\"dependency|degraded\"}[$__rate_interval])) > 0)",
          "legendFormat": "api {{mode}}",
          "refId": "B"
        }
      ],
      "title": "Dependency vs API Error Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 70,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "group": "outcome",
