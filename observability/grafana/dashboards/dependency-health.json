      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"demo-dependency\",route=\"/work\"}[5m])))",
          "legendFormat": "dependency service p95",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_requests_total{service=\"demo-dependency\",route=\"/work\",status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{service=\"demo-dependency\",route=\"/work\"}[5m])), 0.0001)",
          "legendFormat": "dependency 5xx rate",
          "refId": "B"
        }
      ],
      "title": "Dependency Service Health",
      "type": "timeseries"
    }
