        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"demo-dependency\",route=\"/work\"}[$__rate_interval])))",
          "legendFormat": "dependency service p95",
          "refId": "A"
        },
        {
          "expr": "(sum(rate(http_requests_total{service=\"demo-dependency\",route=\"/work\",status_code=~\"5..\"}[$__rate_interval]))\n or 0 * sum(rate(http_requests_total{service=\"demo-dependency\",route=\"/work\"}[$__rate_interval])))\n/ (sum(rate(http_requests_total{service=\"demo-dependency\",route=\"/work\"}[$__rate_interval])) > 0)",
          "legendFormat": "dependency 5xx rate",
          "refId": "B"
        }
      ],
      "title": "Dependency Service Health",
      "type": "timeseries"
    }
