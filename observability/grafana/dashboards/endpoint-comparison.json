          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(http_requests_total{service=\"demo-api\",route=~\"$route\",mode=~\"$mode\",route!~\"/(metrics|health)\",status_code=~\"5..\"}[5m])) / clamp_min(sum by (route) (rate(http_requests_total{service=\"demo-api\",route=~\"$route\",mode=~\"$mode\",route!~\"/(metrics|health)\"}[5m])), 0.0001)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
