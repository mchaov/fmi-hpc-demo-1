      "targets": [
        {
          "expr": "sum by (route) (rate(http_requests_total{service=\"demo-api\",route=~\"$route\",mode=~\"$mode\",route!~\"/(metrics|health)\"}[1m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
