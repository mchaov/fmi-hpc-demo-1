        {
          "expr": "histogram_quantile(0.95, sum by (route, le) (rate(http_request_duration_seconds_bucket{service=\"demo-api\",route=~\"$route\",mode=~\"$mode\",route!~\"/(metrics|health)\"}[5m])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
