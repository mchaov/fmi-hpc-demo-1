{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"demo-api\",route=\"/api/report\",mode=~\"dependency|degraded\"}[5m])))",
          "legendFormat": "api p95",
          "refId": "A"
        },
        {
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"demo-dependency\",route=\"/work\"}[5m])))",
          "legendFormat": "dependency p95",
          "refId": "B"
        }
      ],
      "title": "Latency Correlation · all service traffic",
      "type": "timeseries",
      "description": "Service measurements cover every run in the displayed interval. The log panels below use the selected run ID."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(dependency_errors_total{service=\"demo-api\"}[5m]))",
          "legendFormat": "dependency errors",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_requests_total{service=\"demo-api\",route=\"/api/report\",status_code=~\"5..\"}[5m]))",
          "legendFormat": "api 5xx",
          "refId": "B"
        }
      ],
      "title": "Error Correlation · all service traffic",
      "type": "timeseries",
      "description": "Service measurements cover every run in the displayed interval. The log panels below use the selected run ID."
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{service=\"demo-api\",test_run_id=~\"$test_run_id\"} | json | route!~\"/(health|metrics)\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "API Logs With Trace Links",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{service=\"demo-dependency\",test_run_id=~\"$test_run_id\"} | json | route=\"/work\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Dependency Logs With Trace Links",
      "type": "logs"
    }
