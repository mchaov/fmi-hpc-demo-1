  "refresh": "10s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "demo",
    "performance",
    "tracing"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(k6_http_reqs_total{test_run_id!=\"\"}, test_run_id)",
        "includeAll": true,
        "label": "Log run ID",
        "multi": false,
        "name": "test_run_id",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(k6_http_reqs_total{test_run_id!=\"\"}, test_run_id)",
          "refId": "PrometheusVariableQueryEditor-TestRunId"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "allValue": ".*"
      }
    ]
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "title": "Root Cause Drilldown",
  "uid": "root-cause-drilldown",
  "version": 1
