      "targets": [
        {
          "expr": "sum(rate(k6_http_reqs_total{scenario=~\"$scenario\",test_type=~\"$test_type\",variant=~\"$variant\",run_profile=~\"$run_profile\",test_run_id=~\"$test_run_id\",workload_profile=~\"$workload_profile\",operation=~\"$operation\"}[$__rate_interval]))",
