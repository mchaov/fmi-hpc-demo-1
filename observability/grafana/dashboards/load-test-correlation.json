    {
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 13,
      "options": {
        "content": "**Scenario:** ${scenario:csv}  \n**Test Type:** ${test_type:csv}  \n**Variant:** ${variant:csv}  \n**Run Profile:** ${run_profile:csv}  \n**Test Run ID:** ${test_run_id:csv}  \n**Workload Profile:** ${workload_profile:csv}  \n**Operation:** ${operation:csv}  \n**API Route:** ${route:csv}  \n**API Mode:** ${mode:csv}",
        "mode": "markdown"
      },
      "title": "Selected K6 Metadata",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 3
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "max(max_over_time(k6_vus{scenario=~\"$scenario\",test_type=~\"$test_type\",variant=~\"$variant\",run_profile=~\"$run_profile\",test_run_id=~\"$test_run_id\",workload_profile=~\"$workload_profile\"}[$__range])) or max(max_over_time(k6_vus[$__range]))",
          "instant": true,
          "legendFormat": "vus",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Active VUs",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 3
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
